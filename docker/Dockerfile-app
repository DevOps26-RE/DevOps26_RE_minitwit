# Build Environment (Builder)
FROM cgr.dev/chainguard/go AS builder

WORKDIR /app

# Copy module files and download dependencies first for better layer caching
COPY go.mod go.sum* ./
RUN go mod download

# Copy the source code and compile the application
COPY . .
RUN go build -o minitwit .

# Minimal Runtime Environment, use an extremely lightweight and clean base image to run the application
FROM cgr.dev/chainguard/glibc-dynamic

WORKDIR /app

# Only copy the compiled executable and needed files from the builder stage; discard source code and build tools
COPY --from=builder /app/minitwit .
COPY --from=builder /app/templates ./templates
COPY --from=builder /app/static ./static

EXPOSE 5001

# Safely start the application
ENTRYPOINT ["./minitwit"]