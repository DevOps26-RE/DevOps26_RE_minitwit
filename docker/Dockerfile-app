FROM cgr.dev/chainguard/go

# Set working directory
WORKDIR /app

# Copy module files and download dependencies first for better layer caching
COPY go.mod go.sum* ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the application
RUN go build -o minitwit .

EXPOSE 5001

# Safely start the application
ENTRYPOINT ["./minitwit"]