# =============================================================================
# .env file for docker-stack.yml — generated by Ansible
# Template: ansible/roles/swarm_stack_deploy/templates/stack-env.j2
# Destination: {{ app_deploy_dir }}/.env on swarmnode
# =============================================================================
# This file is read by `docker stack deploy` to substitute ${VAR} references
# in docker-stack.yml. It is regenerated on every Ansible run.
# =============================================================================

# Database address — uses the VPC private IP of dbserver so traffic stays
# on the internal DigitalOcean network (no public egress charges, more secure)
DB_ADDR=postgres://minitwit:minitwit@{{ hostvars['dbserver']['private_ip'] }}:5432/minitwit

# Prometheus external URL — used by the --web.external-url flag so that
# Prometheus generates correct absolute links in its UI
PROM_URL=http://{{ hostvars['swarmnode']['ansible_host'] }}:5001/prometheus

# Grafana root URL — required for sub-path serving (/grafana/) to work
GRAFANA_URL=http://{{ hostvars['swarmnode']['ansible_host'] }}:5001/grafana/
